output "server_public_ip" {
  description = "Public IPv4 address of the Linode instance"
  value       = linode_instance.dataproc_server.ip_address
}

output "ssh_command" {
  description = "SSH connection command"
  value       = "ssh -i ${var.public_key_path} root@${linode_instance.dataproc_server.ip_address}"
}