version: '3.8'

services:
  backend:
    build:
      context: ./app
      dockerfile: Dockerfile
    image: dataproc-backend:latest
    container_name: dataproc_backend
    restart: unless-stopped
    user: "{{ dataproc_uid }}:{{ dataproc_gid }}"
    expose:
      - "5000"
    networks:
      - dataproc_net

  proxy:
    image: nginx:1.25-alpine
    container_name: dataproc_proxy
    restart: unless-stopped
    ports:
      - "8080:80"
    volumes:
      - {{ app_install_dir }}/nginx.conf:/etc/nginx/nginx.conf:ro
      - /var/log/nginx/custom-access.log:/var/log/nginx/custom-access.log
    depends_on:
      - backend
    networks:
      - dataproc_net

networks:
  dataproc_net:
    driver: bridge