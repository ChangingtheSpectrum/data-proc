[Unit]
Description=Data Processor Microservice Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ app_install_dir }}
ExecStartPre=/usr/bin/docker compose -f {{ app_install_dir }}/docker-compose.yml build
ExecStart=/usr/bin/docker compose -f {{ app_install_dir }}/docker-compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f {{ app_install_dir }}/docker-compose.yml down
ExecReload=/usr/bin/docker compose -f {{ app_install_dir }}/docker-compose.yml restart
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target